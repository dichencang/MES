{
  "name": "MES移动端",
  "appid": "",
  "description": "MES 生产制造执行系统移动端（H5 开发调试 / Android APK 交付）",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
