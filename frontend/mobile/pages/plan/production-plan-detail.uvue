<script setup lang="ts">
// 生产计划详情（只读）。契约-计划管理 §3.2。onLoad 接收 ?id=。
// 时间为 ISO 8601 UTC Z，展示按 Asia/Shanghai：用 Date.parse + 8h 偏移，手动格式化（蒸汽模式兼容）。
import {
  getProductionPlan, PLAN_STATUS_LABEL, type ProductionPlanDetailM,
} from '../../api/plan'

const loading = ref(false)
const detail = ref<ProductionPlanDetailM | null>(null)
const pageHeight = ref(0)

function measure(): void {
  const info = uni.getSystemInfoSync()
  const h = (info.windowHeight as number) || 0
  pageHeight.value = h > 0 ? h + 'px' : ''
}

/** UTC Z → 上海时间展示串 */
function shanghai(value: string | null): string {
  if (!value) return '—'
  const d = new Date(value)
  if (isNaN(d.getTime())) return value
  const t = d.getTime() + 8 * 3600 * 1000
  const x = new Date(t)
  const pad = (n: number) => (n < 10 ? '0' + n : '' + n)
  return x.getUTCFullYear() + '-' + pad(x.getUTCMonth() + 1) + '-' + pad(x.getUTCDate())
    + ' ' + pad(x.getUTCHours()) + ':' + pad(x.getUTCMinutes())
}

async function load(id: string): Promise<void> {
  loading.value = true
  try {
    detail.value = await getProductionPlan(id)
  } finally {
    loading.value = false
  }
}

onLoad((options) => {
  measure()
  const id = options && options.id ? String(options.id) : ''
  if (id) load(id)
})
</script>

<template>
  <view class="page uvx-light" :style="pageHeight ? 'height:' + pageHeight : ''">
    <uni-nav-bar title="计划详情" :hide-default-back="false" navigation-bar-text-style="black"></uni-nav-bar>
    <scroll-view class="body" v-if="detail">
      <view class="card">
        <view class="row"><text class="label">计划号：</text><text class="value strong">{{ detail.planNo }}</text></view>
        <view class="row"><text class="label">订单：</text><text class="value">{{ detail.orderNo }}</text></view>
        <view class="row"><text class="label">产品：</text><text class="value">{{ detail.productCode }} {{ detail.productName }}</text></view>
        <view class="row"><text class="label">计划量：</text><text class="value">{{ detail.plannedQty }} {{ detail.unitName }}</text></view>
        <view class="row"><text class="label">状态：</text><text class="value">{{ PLAN_STATUS_LABEL[detail.status] || detail.status }}</text></view>
        <view class="row"><text class="label">开始：</text><text class="value">{{ shanghai(detail.plannedStartAt) }}</text></view>
        <view class="row"><text class="label">结束：</text><text class="value">{{ shanghai(detail.plannedEndAt) }}</text></view>
        <view class="row"><text class="label">BOM / 路线：</text><text class="value">{{ detail.bomVersion ? 'V' + detail.bomVersion.version : '—' }} / {{ detail.routingVersion ? 'V' + detail.routingVersion.version : '—' }}</text></view>
        <view class="row" v-if="detail.workOrder"><text class="label">关联工单：</text><text class="value">{{ detail.workOrder.workOrderNo }}</text></view>
        <view class="row" v-if="detail.remark"><text class="label">备注：</text><text class="value">{{ detail.remark }}</text></view>
      </view>
    </scroll-view>
    <view v-if="loading" class="loading"><text class="loading-text">加载中…</text></view>
  </view>
</template>

<style>
.page { width: 100%; flex-direction: column; background: #f4f7fb; }
.body { flex: 1; }
.card { margin: 12px 16px; background: #ffffff; border-radius: 10px; padding: 12px 14px; }
.row { flex-direction: row; align-items: center; margin-bottom: 8px; }
.label { font-size: 12px; color: #8a98aa; }
.value { font-size: 12px; color: #263b55; }
.strong { font-weight: 600; color: #1f2d3d; }
.loading { padding: 20px; align-items: center; }
.loading-text { font-size: 13px; color: #a8b4c4; }
</style>
