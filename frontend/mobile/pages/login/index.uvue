<script setup lang="ts">
// 登录页：复用现有后端接口（/auth/captcha、/auth/login、/auth/me、/permissions/my）。
// 不依赖 axios / pinia / vue-router；错误提示由请求层统一 toast，本页只按 code 调整表单。
import { getCaptcha, login, getMe, getMyPermissions } from '../../api/auth'
import { ApiError } from '../../utils/request'
import { tokenStore, profileStore, rememberUsername, getRememberedUsername } from '../../utils/auth'
import { BIZ_CODE, LOCAL_CODE } from '../../constants/biz'

const APP_TITLE = 'MES 生产执行系统'

// 注意：必须用 reactive/ref 包裹，否则 uvue 模板不会随状态更新（曾导致验证码区卡在"加载中"）
const form = reactive({
  username: getRememberedUsername(),
  password: '',
  captchaCode: '',
})
const remember = ref(form.username.length > 0)
const loading = ref(false)
const captcha = reactive({
  id: '',
  image: '',
  loading: false,
  failed: false,
  expired: false,
})
let seq = 0
let countdown: number | undefined
let countdownLeft = 0

// 页面根节点必须有确定高度，flex:1 才有参照：取窗口可用高度（px）
const pageHeight = ref(0)
const statusBarHeight = ref(0)
function measure(): void {
  const info = uni.getSystemInfoSync()
  const h = (info.windowHeight as number) || 0
  pageHeight.value = h > 0 ? h + 'px' : ''
  statusBarHeight.value = (info.statusBarHeight as number) || 0
}

function stopCountdown(): void {
  if (countdown) clearInterval(countdown)
  countdown = undefined
}

function startCountdown(seconds: number): void {
  stopCountdown()
  countdownLeft = seconds
  countdown = setInterval(() => {
    countdownLeft--
    if (countdownLeft <= 0) {
      captcha.expired = true
      stopCountdown()
    }
  }, 1000)
}

async function loadCaptcha(): Promise<void> {
  if (captcha.loading) return
  const my = ++seq
  captcha.loading = true
  captcha.failed = false
  try {
    const res = await getCaptcha()
    if (my !== seq) return
    captcha.id = res.captchaId
    captcha.image = res.image
    captcha.expired = false
    form.captchaCode = ''
    startCountdown(res.expiresIn)
  } catch (error) {
    if (my !== seq) return
    captcha.failed = true
    captcha.id = ''
    captcha.image = ''
    stopCountdown()
  } finally {
    if (my === seq) captcha.loading = false
  }
}

function onCaptchaInput(event: any): void {
  const raw = event && event.detail ? event.detail.value : ''
  const value = String(raw).replace(/[^0-9a-zA-Z]/g, '').slice(0, 4).toUpperCase()
  form.captchaCode = value
}

const captchaText = computed(() => {
  if (captcha.loading) return '加载中'
  if (captcha.failed) return '点击重试'
  if (captcha.expired) return '点击刷新'
  if (!captcha.image) return '点击获取'
  return ''
})

async function handleLogin(): Promise<void> {
  if (loading.value) return
  if (!form.username) {
    uni.showToast({ title: '请输入账号', icon: 'none' })
    return
  }
  if (!form.password) {
    uni.showToast({ title: '请输入密码', icon: 'none' })
    return
  }
  if (!captcha.id || captcha.expired) {
    uni.showToast({
      title: captcha.failed ? '验证码获取失败，请重试' : '请先获取验证码',
      icon: 'none',
    })
    loadCaptcha()
    return
  }
  if (form.captchaCode.length !== 4) {
    uni.showToast({ title: '请输入 4 位验证码', icon: 'none' })
    return
  }

  loading.value = true
  try {
    const session = await login({
      username: form.username,
      password: form.password,
      captchaId: captcha.id,
      captchaCode: form.captchaCode,
    })
    tokenStore.set(session.accessToken, session.refreshToken)
    rememberUsername(form.username, remember.value)

    // 拉取用户信息与权限快照，失败不影响登录（进入主页后再补）
    try {
      const me = await getMe()
      const perm = await getMyPermissions()
      profileStore.setUser(me)
      profileStore.setPermissions(perm)
    } catch (error) {
      // 请求层已提示，这里静默
    }

    stopCountdown()
    uni.reLaunch({ url: '/pages/index/index' })
  } catch (error) {
    const code = error instanceof ApiError ? error.code : undefined
    // 2004 账号密码错、2005 验证码错、超时/断网：验证码已被消费或不可信，必须换图
    if (
      code === BIZ_CODE.BAD_CREDENTIALS ||
      code === BIZ_CODE.CAPTCHA_INVALID ||
      code === LOCAL_CODE.TIMEOUT ||
      code === LOCAL_CODE.NETWORK
    ) {
      loadCaptcha()
    }
    // 1001 字段校验：保留当前图片；提示已由请求层统一弹出
  } finally {
    loading.value = false
  }
}

onLoad(() => {
  measure()
  loadCaptcha()
})

onReady(() => {
  // 首帧可能拿不到状态栏高度，渲染完成后再量一次
  measure()
})

onUnload(() => {
  stopCountdown()
})
</script>

<template>
  <!-- 用 min-height 而非 height：内容超过一屏时背景跟着长，否则底部会露出根容器白底 -->
  <view class="page uvx-light" :style="pageHeight ? 'min-height:' + pageHeight : ''">
    <!-- 自绘状态栏占位：navigationStyle=custom 后必须自己避开状态栏，否则内容会顶到刘海/时间下面 -->
    <view :style="'height:' + statusBarHeight + 'px'"></view>

    <!-- 自绘标题栏：比系统 56dp 矮，只保留下"登录"标识 -->
    <view class="self-nav">
      <text class="self-nav-title">登录</text>
    </view>

    <view class="brand">
      <view class="logo">MES</view>
      <view class="brand-copy">
        <text class="app-name">{{ APP_TITLE }}</text>
        <text class="brand-sub">智能制造 · 高效生产</text>
      </view>
    </view>

    <view class="card">
      <text class="card-title">欢迎登录</text>
      <text class="card-sub">请使用企业账号登录，未开通请联系系统管理员</text>

      <input
        class="input"
        v-model="form.username"
        placeholder="请输入账号"
        :disabled="loading"
      />

      <input
        class="input"
        v-model="form.password"
        :password="true"
        placeholder="请输入密码"
        :disabled="loading"
      />

      <view class="captcha-row">
        <input
          class="input captcha-input"
          :value="form.captchaCode"
          @input="onCaptchaInput"
          placeholder="4 位验证码"
          maxlength="4"
          :disabled="loading"
        />
        <view class="captcha-box" @click="loadCaptcha">
          <image
            v-if="captcha.image && !captcha.expired"
            class="captcha-image"
            :src="captcha.image"
            mode="aspectFit"
          ></image>
          <text v-else class="captcha-tip">{{ captchaText }}</text>
        </view>
      </view>

      <view class="remember-row" @click="remember = !remember">
        <view :class="remember ? 'checkbox checked' : 'checkbox'">
          <!-- 选中态必须有对勾，只涂蓝方块用户无法确认是否勾选 -->
          <view v-if="remember" class="check-mark"></view>
        </view>
        <text class="remember-text">记住账号</text>
      </view>
      <view class="submit" @click="handleLogin">
        <text class="submit-text">{{ loading ? '登录中…' : '登 录' }}</text>
      </view>

      <view class="dev-tip">
        <text class="dev-tip-text">开发环境种子账号：admin / admin123</text>
      </view>
    </view>
  </view>
</template>

<style>
/* uvue CSS 受限子集：只支持 classname 选择器、display 仅 flex/none、无 100vh / 角度渐变 / gap */
.page {
  width: 100%;
  background: linear-gradient(to bottom, #edf5ff 0%, #f8fbff 42%, #e7f1ff 100%);
  padding: 10px 20px 16px;
}
/* 自绘标题栏：44px 比系统导航栏（56dp+）矮，只承担"登录"标识 */
.self-nav {
  height: 44px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.self-nav-title {
  font-size: 17px;
  font-weight: 600;
  color: #1f2d3d;
}
.brand {
  flex-direction: row;
  align-items: center;
  padding: 6px 4px 16px;
}
.logo {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: linear-gradient(to bottom right, #4a8cf7, #2f6fe4);
  color: #ffffff;
  font-size: 12px;
  font-weight: 700;
  text-align: center;
  line-height: 40px;
  margin-right: 10px;
}
.brand-copy {
  flex: 1;
}
.app-name {
  display: flex;
  font-size: 15px;
  font-weight: 700;
  color: #18385f;
}
.brand-sub {
  display: flex;
  margin-top: 4px;
  font-size: 11px;
  color: #7188a8;
}
.card {
  background: #ffffff;
  border-radius: 18px;
  padding: 22px 20px 18px;
  box-shadow: 0 12px 32px rgba(52, 105, 176, 0.12);
}
.card-title {
  display: flex;
  font-size: 21px;
  font-weight: 700;
  color: #1d3554;
}
.card-sub {
  display: flex;
  margin-top: 6px;
  margin-bottom: 20px;
  font-size: 12px;
  color: #8a98aa;
  line-height: 1.6;
}
.input {
  width: 100%;
  height: 44px;
  padding: 0 12px;
  margin-bottom: 12px;
  border: 1px solid #e1e8f1;
  border-radius: 10px;
  background: #fbfdff;
  color: #263b55;
  font-size: 14px;
}
.captcha-row {
  flex-direction: row;
  align-items: center;
}
.captcha-input {
  flex: 1;
  margin-bottom: 0;
}
.captcha-box {
  width: 118px;
  height: 44px;
  margin-left: 10px;
  border: 1px solid #e1e8f1;
  border-radius: 10px;
  background: #f3f7fc;
  align-items: center;
  justify-content: center;
}
.captcha-image {
  width: 100%;
  height: 100%;
}
.captcha-tip {
  font-size: 13px;
  color: #7188a8;
}
.remember-row {
  flex-direction: row;
  align-items: center;
  margin-top: 14px;
  margin-bottom: 16px;
}
.checkbox {
  width: 16px;
  height: 16px;
  border: 1px solid #b9cbe0;
  border-radius: 4px;
  margin-right: 8px;
  align-items: center;
  justify-content: center;
}
.checkbox.checked {
  background: #3488f2;
  border-color: #3488f2;
}
/* 对勾用两条边框旋转拼成，uvue 无字体图标依赖，性能好且可自由缩放 */
.check-mark {
  width: 8px;
  height: 4px;
  border-left: 1.5px solid #ffffff;
  border-bottom: 1.5px solid #ffffff;
  transform: rotate(-45deg);
  margin-top: -2px;
}
.remember-text {
  font-size: 13px;
  color: #5e7695;
}
/* 用 view 自绘按钮：uvue 的 button 是原生组件，自带内边距/最小高度，和外设 height 冲突 */
.submit {
  width: 100%;
  height: 46px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  background: linear-gradient(to right, #3299f8 0%, #2878ec 55%, #315be0 100%);
}
.submit-text {
  color: #ffffff;
  font-size: 16px;
  font-weight: 600;
  letter-spacing: 2px;
}
.dev-tip {
  margin-top: 14px;
  padding: 8px;
  border-radius: 8px;
  background: #fff8e9;
}
.dev-tip-text {
  display: flex;
  font-size: 11px;
  color: #9a793e;
  text-align: center;
}
</style>
