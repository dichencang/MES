<script setup lang="ts">
// 工单详情（只读）。契约-生产工单 §三。onLoad 接收 ?id=。
// 时间为 ISO 8601 UTC Z，展示按 Asia/Shanghai（+8h 手动格式化，蒸汽模式兼容）。
import { getWorkOrder, WO_STATUS_LABEL, type WorkOrderDetailM, type WorkOrderStepM } from '../../api/workorder'

const loading = ref(false)
const detail = ref<WorkOrderDetailM | null>(null)
const pageHeight = ref(0)

function measure(): void {
  const info = uni.getSystemInfoSync()
  const h = (info.windowHeight as number) || 0
  pageHeight.value = h > 0 ? h + 'px' : ''
}

/** UTC Z → 上海时间展示串 */
function shanghai(value: string | null): string {
  if (!value) return '—'
  const d = new Date(value)
  if (isNaN(d.getTime())) return value
  const x = new Date(d.getTime() + 8 * 3600 * 1000)
  const pad = (n: number) => (n < 10 ? '0' + n : '' + n)
  return x.getUTCFullYear() + '-' + pad(x.getUTCMonth() + 1) + '-' + pad(x.getUTCDate())
    + ' ' + pad(x.getUTCHours()) + ':' + pad(x.getUTCMinutes())
}

function statusText(s: string): string {
  return WO_STATUS_LABEL[s] || s
}

/** 当前有效派工人员（endedAt 为 null） */
function currentAssignees(step: WorkOrderStepM): string {
  const names: string[] = []
  for (const a of step.assignees) {
    if (!a.endedAt) names.push(a.assigneeName)
  }
  return names.length ? names.join('、') : '未派工'
}

async function load(id: string): Promise<void> {
  loading.value = true
  try {
    detail.value = await getWorkOrder(id)
  } finally {
    loading.value = false
  }
}

onLoad((options) => {
  measure()
  const id = options && options.id ? String(options.id) : ''
  if (id) load(id)
})
</script>

<template>
  <view class="page uvx-light" :style="pageHeight ? 'height:' + pageHeight : ''">
    <uni-nav-bar title="工单详情" :hide-default-back="false" navigation-bar-text-style="black"></uni-nav-bar>
    <scroll-view class="body">
      <view v-if="detail" class="card">
        <view class="row">
          <text class="wo-no">{{ detail.workOrderNo }}</text>
          <text class="status">{{ statusText(detail.status) }}</text>
        </view>
        <view class="row"><text class="label">产品：</text><text class="value">{{ detail.productCode }} {{ detail.productName }}</text></view>
        <view class="row"><text class="label">计划量：</text><text class="value">{{ detail.plannedQty }} {{ detail.unitName }}</text></view>
        <view class="row"><text class="label">计划开始：</text><text class="value">{{ shanghai(detail.plannedStartAt) }}</text></view>
        <view class="row"><text class="label">计划结束：</text><text class="value">{{ shanghai(detail.plannedEndAt) }}</text></view>
        <view class="row"><text class="label">来源计划：</text><text class="value">{{ detail.planNo || '手工工单' }}</text></view>
        <view class="row"><text class="label">开工时间：</text><text class="value">{{ shanghai(detail.startedAt) }}</text></view>
        <view class="row" v-if="detail.remark"><text class="label">备注：</text><text class="value">{{ detail.remark }}</text></view>
        <view class="row" v-if="detail.cancelReason"><text class="label">撤销原因：</text><text class="value">{{ detail.cancelReason }}</text></view>
      </view>

      <view v-if="detail" class="card">
        <text class="section-title">工序与派工</text>
        <view v-for="s in detail.steps" :key="s.id" class="step-row">
          <text class="step-seq">{{ s.seq }}</text>
          <view class="step-main">
            <text class="step-name">{{ s.processCode }} {{ s.processName }}</text>
            <text class="step-assignee">{{ currentAssignees(s) }}</text>
          </view>
        </view>
        <view v-if="!detail.steps.length" class="empty"><text class="empty-text">暂无工序</text></view>
      </view>

      <view v-if="detail" class="tip"><text class="tip-text">移动端首期只读，操作请在 Web 端完成</text></view>
      <view v-if="!detail && !loading" class="empty"><text class="empty-text">未找到工单</text></view>
    </scroll-view>
  </view>
</template>

<style>
.page { width: 100%; flex-direction: column; background: #f4f7fb; }
.body { flex: 1; }
.card { margin: 12px 16px 0; background: #ffffff; border-radius: 10px; padding: 12px 14px; }
.row { flex-direction: row; align-items: center; margin-bottom: 6px; }
.wo-no { font-size: 16px; font-weight: 600; color: #1f2d3d; flex: 1; }
.status { font-size: 12px; color: #2f6fe4; }
.label { font-size: 12px; color: #8a98aa; }
.value { font-size: 12px; color: #263b55; flex: 1; }
.section-title { font-size: 13px; font-weight: 600; color: #1f2d3d; margin-bottom: 8px; }
.step-row { flex-direction: row; align-items: flex-start; padding: 8px 0; border-top: 1px solid #f0f3f7; }
.step-seq { width: 28px; font-size: 12px; color: #8a98aa; }
.step-main { flex: 1; flex-direction: column; }
.step-name { font-size: 13px; color: #263b55; }
.step-assignee { font-size: 12px; color: #8a98aa; margin-top: 2px; }
.tip { margin: 12px 16px; align-items: center; }
.tip-text { font-size: 12px; color: #a8b4c4; }
.empty { margin-top: 30px; align-items: center; }
.empty-text { font-size: 13px; color: #a8b4c4; }
</style>
