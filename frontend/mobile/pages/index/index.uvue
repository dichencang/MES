<script setup lang="ts">
// 落地页：登录后的最小闭环。展示用户快照 + 规划中的 5 个模块入口（暂为占位）。
// 后续按契约逐模块替换为真实页面，不在此堆业务代码。
import { logout } from '../../api/auth'
import { tokenStore, profileStore } from '../../utils/auth'
import type { UserInfo } from '../../types'

const user = ref<UserInfo | null>(profileStore.getUser())

const entries = [
  { key: 'home', name: '首页', desc: '生产总览与快捷入口' },
  { key: 'exception', name: '异常', desc: '异常上报与处理' },
  { key: 'workbench', name: '工作台', desc: '扫码报工与质检' },
  { key: 'todo', name: '待办', desc: '我的待处理任务' },
  { key: 'mine', name: '我的', desc: '个人信息与设置' },
]

const rolesText = computed(() => {
  if (!user.value) return '—'
  return user.value.roles.map((r) => r.roleName).join('、') || '—'
})

function openEntry(name: string): void {
  uni.showToast({ title: name + '：模块待开发', icon: 'none' })
}

async function handleLogout(): Promise<void> {
  try {
    await logout()
  } catch (error) {
    // 请求层已提示；退出接口失败也要清本地会话
  }
  tokenStore.clear()
  profileStore.clear()
  uni.reLaunch({ url: '/pages/login/index' })
}

onLoad(() => {
  if (!tokenStore.access) {
    uni.reLaunch({ url: '/pages/login/index' })
  }
})
</script>

<template>
  <view class="page">
    <view class="hero">
      <text class="hello">你好，{{ user ? user.realName : '用户' }}</text>
      <text class="meta">{{ user && user.deptName ? user.deptName : '未分配部门' }} · {{ rolesText }}</text>
    </view>

    <view class="section-title">功能入口</view>
    <view class="grid">
      <view v-for="item in entries" :key="item.key" class="entry" @click="openEntry(item.name)">
        <view class="entry-mark">{{ item.name.slice(0, 1) }}</view>
        <text class="entry-name">{{ item.name }}</text>
        <text class="entry-desc">{{ item.desc }}</text>
      </view>
    </view>

    <view class="footer-info">
      <text class="footer-text">后端接口已连通 · 业务模块待开发</text>
    </view>

    <button class="logout" @click="handleLogout">退出登录</button>
  </view>
</template>

<style>
