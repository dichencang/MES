  width: 48%;
  background: #ffffff;
  border-radius: 12px;
  padding: 16px 14px;
  margin-bottom: 12px;
  box-shadow: 0 4px 14px rgba(52, 105, 176, 0.06);
}
.entry-mark {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: #eaf3ff;
  color: #2f6fe4;
  font-size: 14px;
  font-weight: 700;
  text-align: center;
  line-height: 32px;
  margin-bottom: 10px;
}
.entry-name {
  display: flex;
  font-size: 14px;
  font-weight: 600;
  color: #263b55;
}
.entry-desc {
  display: flex;
  margin-top: 4px;
  font-size: 11px;
  color: #94a3b8;
  line-height: 1.5;
}
.footer-info {
  margin-top: 20px;
  text-align: center;
}
