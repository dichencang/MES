<script setup lang="ts">
// 移动端主页面：底部 5 Tab（首页 | 异常 | 工作台 | 待办 | 我的）。
// 各 Tab 内容严格依据需求真源《四、移动端页面结构》：
//   首页 = 问候 + 统计卡片（昨日产量/达成率/合格率/返工/订单/出库）+ 工单环形图
//   工作台 = 功能入口目录（计划管理 / 生产管理 / 质量管理 / 仓库管理）
//   异常 = 异常上报 + 列表；待办 = 待办列表；我的 = 个人信息/今日任务/资料/改密/关于/退出
// 注意：后端尚无看板统计接口，首页数值为占位，接口就绪后替换。
import { logout } from '../../api/auth'
import { tokenStore, profileStore } from '../../utils/auth'
import type { UserInfo } from '../../types'

const user = ref<UserInfo | null>(profileStore.getUser())
const activeTab = ref('home')

// 底部 5 Tab，顺序固定（需求真源）
const tabs = [
  { key: 'home', name: '首页' },
  { key: 'exception', name: '异常' },
  { key: 'workbench', name: '工作台' },
  { key: 'todo', name: '待办' },
  { key: 'mine', name: '我的' },
]

// 首页统计卡片
const stats = [
  { key: 'output', label: '昨日产量', value: '—' },
  { key: 'rate', label: '达成率', value: '—' },
  { key: 'qualified', label: '合格率', value: '—' },
  { key: 'rework', label: '返工', value: '—' },
  { key: 'order', label: '订单', value: '—' },
  { key: 'outbound', label: '出库', value: '—' },
]

// 工作台功能入口目录（需求真源分组）
type WorkItem = { key: string; name: string }
const workGroups: Array<{ key: string; title: string; items: WorkItem[] }> = [
  {
    key: 'plan',
    title: '计划管理',
    items: [
      { key: 'so', name: '销售订单' },
      { key: 'plan', name: '生产计划' },
    ],
  },
  {
    key: 'prod',
    title: '生产管理',
    items: [
      { key: 'wo', name: '生产工单' },
      { key: 'report', name: '生产报工' },
      { key: 'reportLog', name: '报工记录' },
    ],
  },
  {
    key: 'qc',
    title: '质量管理',
    items: [
      { key: 'iqc', name: '来料检验' },
      { key: 'ipqc', name: '过程检验' },
      { key: 'fqc', name: '最终检验' },
    ],
  },
  {
    key: 'wh',
    title: '仓库管理',
    items: [
      { key: 'in', name: '采购入库' },
      { key: 'pick', name: '生产领料' },
      { key: 'return', name: '生产退料' },
      { key: 'out', name: '产品出库' },
      { key: 'stock', name: '库存查询' },
    ],
  },
]

const currentTabName = computed(() => {
  const t = tabs.find((x) => x.key === activeTab.value)
  return t ? t.name : '首页'
})

const greeting = computed(() => {
  const h = new Date().getHours()
  if (h < 11) return '早上好'
  if (h < 14) return '中午好'
  if (h < 18) return '下午好'
  return '晚上好'
})

const rolesText = computed(() => {
  if (!user.value) return '—'
  return user.value.roles.map((r) => r.roleName).join('、') || '—'
})

const deptText = computed(() => {
  if (!user.value) return '未分配部门'
  return user.value.deptName ? user.value.deptName : '未分配部门'
})

// 页面高度：uvue 根节点需确定高度，flex:1 才有参照
// scrollHeight = 一屏高 - 状态栏 - 标题栏(44) - 底部 Tab(54)
// scroll-view 在 uvue 里不吃 flex:1，必须给明确高度，否则会把 Tab 栏挤出屏幕
const pageHeight = ref(0)
const scrollHeight = ref(0)
const statusBarHeight = ref(0)
const NAV_H = 44
const TAB_H = 54
function measure(): void {
  const info = uni.getSystemInfoSync()
  const h = (info.windowHeight as number) || 0
  const sb = (info.statusBarHeight as number) || 0
  statusBarHeight.value = sb
  pageHeight.value = h > 0 ? h + 'px' : ''
  scrollHeight.value = h > 0 ? h - sb - NAV_H - TAB_H + 'px' : ''
}

function switchTab(key: string): void {
  activeTab.value = key
}

function openPage(name: string): void {
  uni.showToast({ title: name + '：模块待开发', icon: 'none' })
}

async function handleLogout(): Promise<void> {
  try {
    await logout()
  } catch (error) {
    // 请求层已提示；退出接口失败也要清本地会话
  }
  tokenStore.clear()
  profileStore.clear()
  uni.reLaunch({ url: '/pages/login/index' })
}

onLoad(() => {
  if (!tokenStore.access) {
    uni.reLaunch({ url: '/pages/login/index' })
    return
  }
  measure()
})

onReady(() => {
  measure()
})
</script>

<template>
  <view class="page" :style="pageHeight ? 'min-height:' + pageHeight : ''">
    <view :style="'height:' + statusBarHeight + 'px'"></view>

    <!-- 自绘标题栏：不用系统导航栏，避免 56dp 白条 -->
    <view class="nav">
      <text class="nav-title">{{ currentTabName }}</text>
    </view>

    <scroll-view class="body" scroll-y="true" :style="scrollHeight ? 'height:' + scrollHeight : ''">
      <!-- ===== 首页：问候 + 统计卡片 + 工单环形图 ===== -->
      <view v-if="activeTab === 'home'" class="pane">
        <view class="hero">
          <text class="hero-greet">{{ greeting }}，{{ user ? user.realName : '用户' }}</text>
          <text class="hero-meta">{{ deptText }}</text>
        </view>

        <view class="stat-grid">
          <view v-for="s in stats" :key="s.key" class="stat-cell">
            <text class="stat-value">{{ s.value }}</text>
            <text class="stat-label">{{ s.label }}</text>
          </view>
        </view>

        <view class="chart-card">
          <text class="chart-title">工单状态分布</text>
          <view class="chart-body">
            <view class="donut">
              <view class="donut-hole">
                <text class="donut-num">—</text>
                <text class="donut-unit">工单</text>
              </view>
            </view>
            <view class="legend">
              <view class="legend-row">
                <view class="legend-dot dot-pending"></view>
                <text class="legend-name">待排</text>
                <text class="legend-val">—</text>
              </view>
              <view class="legend-row">
                <view class="legend-dot dot-running"></view>
                <text class="legend-name">生产中</text>
                <text class="legend-val">—</text>
              </view>
              <view class="legend-row">
                <view class="legend-dot dot-done"></view>
                <text class="legend-name">已完成</text>
                <text class="legend-val">—</text>
              </view>
            </view>
          </view>
          <text class="chart-tip">统计接口就绪后展示真实数据</text>
        </view>
      </view>

      <!-- ===== 工作台：功能入口目录（横向网格，短名称竖排浪费空间） ===== -->
      <view v-if="activeTab === 'workbench'" class="pane">
        <view v-for="g in workGroups" :key="g.key" class="group">
          <text class="group-title">{{ g.title }}</text>
          <view class="group-grid">
            <view v-for="it in g.items" :key="it.key" class="group-cell" @click="openPage(it.name)">
              <text class="group-cell-text">{{ it.name }}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- ===== 异常 ===== -->
      <view v-if="activeTab === 'exception'" class="pane">
        <view class="action-row">
          <view class="action-btn" @click="openPage('异常上报')">
            <text class="action-btn-text">异常上报</text>
          </view>
        </view>
        <view class="empty">
          <text class="empty-title">暂无异常记录</text>
          <text class="empty-desc">异常列表与处理功能待开发</text>
        </view>
      </view>

      <!-- ===== 待办 ===== -->
      <view v-if="activeTab === 'todo'" class="pane">
        <view class="empty">
          <text class="empty-title">暂无待办</text>
          <text class="empty-desc">待办列表与处理功能待开发</text>
        </view>
      </view>

      <!-- ===== 我的 ===== -->
      <view v-if="activeTab === 'mine'" class="pane">
        <view class="me-card">
          <view class="me-avatar">
            <text class="me-avatar-text">{{ user ? user.realName.slice(0, 1) : '用' }}</text>
          </view>
          <view class="me-info">
            <text class="me-name">{{ user ? user.realName : '用户' }}</text>
            <text class="me-sub">{{ deptText }} · {{ rolesText }}</text>
          </view>
        </view>

        <view class="menu-card">
          <view class="menu-row" @click="openPage('今日任务')">
            <text class="menu-label">今日任务</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-row" @click="openPage('个人资料')">
            <text class="menu-label">个人资料</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-row" @click="openPage('修改密码')">
            <text class="menu-label">修改密码</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-row menu-row-last" @click="openPage('关于')">
            <text class="menu-label">关于</text>
            <text class="menu-arrow">›</text>
          </view>
        </view>

        <view class="logout" @click="handleLogout">
          <text class="logout-text">退出登录</text>
        </view>
      </view>
    </scroll-view>

    <!-- 底部 5 Tab -->
    <view class="tabbar">
      <view v-for="t in tabs" :key="t.key" class="tab" @click="switchTab(t.key)">
        <text :class="activeTab === t.key ? 'tab-name tab-name-on' : 'tab-name'">{{ t.name }}</text>
        <view :class="activeTab === t.key ? 'tab-line tab-line-on' : 'tab-line'"></view>
      </view>
    </view>
  </view>
</template>

<style>
/* uvue CSS 子集：仅 classname 选择器、display 仅 flex/none、无 100vh / 角度渐变 / gap / calc */
.page {
  width: 100%;
  flex-direction: column;
  background: #f4f7fb;
}
.nav {
  height: 44px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.nav-title {
  font-size: 17px;
  font-weight: 600;
  color: #1f2d3d;
}
.body {
  flex: 1;
}
.pane {
  padding: 8px 16px 16px;
}

/* 首页 */
.hero {
  padding: 4px 2px 14px;
}
.hero-greet {
  display: flex;
  font-size: 19px;
  font-weight: 700;
  color: #1c477e;
}
.hero-meta {
  display: flex;
  margin-top: 4px;
  font-size: 12px;
  color: #8a98aa;
}
.stat-grid {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}
.stat-cell {
  width: 31.5%;
  background: #ffffff;
  border-radius: 12px;
  padding: 14px 10px;
  margin-bottom: 10px;
  align-items: center;
}
.stat-value {
  font-size: 20px;
  font-weight: 700;
  color: #2f6fe4;
}
.stat-label {
  margin-top: 4px;
  font-size: 11px;
  color: #94a3b8;
}
.chart-card {
  margin-top: 6px;
  background: #ffffff;
  border-radius: 12px;
  padding: 16px 14px;
}
.chart-title {
  font-size: 14px;
  font-weight: 600;
  color: #1f2d3d;
}
.chart-body {
  flex-direction: row;
  align-items: center;
  margin-top: 14px;
}
.donut {
  width: 108px;
  height: 108px;
  border-radius: 54px;
  background: #dfeaff;
  align-items: center;
  justify-content: center;
}
.donut-hole {
  width: 72px;
  height: 72px;
  border-radius: 36px;
  background: #ffffff;
  align-items: center;
  justify-content: center;
}
.donut-num {
  font-size: 18px;
  font-weight: 700;
  color: #2f6fe4;
}
.donut-unit {
  font-size: 10px;
  color: #94a3b8;
}
.legend {
  flex: 1;
  margin-left: 18px;
}
.legend-row {
  flex-direction: row;
  align-items: center;
  margin-bottom: 10px;
}
.legend-dot {
  width: 8px;
  height: 8px;
  border-radius: 4px;
  margin-right: 8px;
}
.dot-pending {
  background: #b9cbe0;
}
.dot-running {
  background: #4a8cf7;
}
.dot-done {
  background: #22b07d;
}
.legend-name {
  flex: 1;
  font-size: 12px;
  color: #5e7695;
}
.legend-val {
  font-size: 12px;
  font-weight: 600;
  color: #263b55;
}
.chart-tip {
  margin-top: 10px;
  font-size: 11px;
  color: #a8b4c4;
}

/* 工作台：分组卡片 + 三列网格。用 space-between 而不是 margin-right，
   否则 31.5%*3 + 2.75%*3 = 102.75% 超宽，第三列必被挤到下一行。 */
.group {
  margin-bottom: 12px;
  background: #ffffff;
  border-radius: 12px;
  padding: 14px 14px 4px;
}
.group-title {
  font-size: 13px;
  font-weight: 600;
  color: #8a98aa;
}
.group-grid {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 10px;
}
.group-cell {
  width: 31.5%;
  height: 42px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background: #f5f8fd;
  margin-bottom: 10px;
}
.group-cell-text {
  font-size: 13px;
  color: #263b55;
}

/* 异常 */
.action-row {
  flex-direction: row;
  margin-bottom: 14px;
}
.action-btn {
  flex: 1;
  height: 44px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  background: linear-gradient(to right, #3299f8 0%, #2878ec 100%);
}
.action-btn-text {
  font-size: 14px;
  font-weight: 600;
  color: #ffffff;
}

/* 空态 */
.empty {
  margin-top: 70px;
  align-items: center;
}
.empty-title {
  font-size: 15px;
  color: #5e7695;
}
.empty-desc {
  margin-top: 8px;
  font-size: 12px;
  color: #a8b4c4;
}

/* 我的 */
.me-card {
  flex-direction: row;
  align-items: center;
  background: #ffffff;
  border-radius: 12px;
  padding: 16px 14px;
}
.me-avatar {
  width: 46px;
  height: 46px;
  border-radius: 23px;
  background: #e8f1ff;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
}
.me-avatar-text {
  font-size: 17px;
  font-weight: 700;
  color: #2f6fe4;
}
.me-info {
  flex: 1;
}
.me-name {
  font-size: 16px;
  font-weight: 600;
  color: #1f2d3d;
}
.me-sub {
  display: flex;
  margin-top: 4px;
  font-size: 11px;
  color: #8a98aa;
}
.menu-card {
  margin-top: 12px;
  background: #ffffff;
  border-radius: 12px;
  padding: 0 14px;
}
.menu-row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 14px 0;
  border-bottom: 1px solid #f2f5f9;
}
.menu-row-last {
  border-bottom: 0;
}
.menu-label {
  font-size: 14px;
  color: #263b55;
}
.menu-arrow {
  font-size: 15px;
  color: #c4cfdd;
}
.logout {
  margin-top: 16px;
  height: 46px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  background: #ffffff;
  border: 1px solid #e6ebf2;
}
.logout-text {
  font-size: 14px;
  color: #d9534f;
}

/* 底部 Tab */
.tabbar {
  flex-direction: row;
  height: 54px;
  background: #ffffff;
  border-top: 1px solid #e8edf4;
}
.tab {
  flex: 1;
  align-items: center;
  justify-content: center;
}
.tab-name {
  font-size: 13px;
  color: #94a3b8;
}
.tab-name-on {
  color: #2f6fe4;
  font-weight: 600;
}
.tab-line {
  width: 16px;
  height: 2px;
  border-radius: 1px;
  margin-top: 5px;
  background: transparent;
}
.tab-line-on {
  background: #2f6fe4;
}
</style>
