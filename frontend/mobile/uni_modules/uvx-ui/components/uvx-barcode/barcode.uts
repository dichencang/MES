import type { BarcodeResult } from "./types/index.uts";

type CodeSet = "A" | "B" | "C";
type TokenKind = "char" | "fnc1";

type BarcodeToken = {
   kind: TokenKind;
   code: number;
   text: string;
};

type Candidate = {
   codewords: number[];
   switchCount: number;
   shiftCount: number;
};

const CODE_SHIFT: number = 98;
const CODE_C: number = 99;
const CODE_B: number = 100;
const CODE_A: number = 101;
const CODE_FNC1: number = 102;
const CODE_STOP: number = 106;
const FNC1_TOKEN: string = "{FNC1}";

// 标准 CODE128 码字宽度模式，最后一项是 13 模块的 STOP。
const CODE_PATTERNS: string[] = [
   "212222", "222122", "222221", "121223", "121322", "131222", "122213", "122312", "132212", "221213",
   "221312", "231212", "112232", "122132", "122231", "113222", "123122", "123221", "223211", "221132",
   "221231", "213212", "223112", "312131", "311222", "321122", "321221", "312212", "322112", "322211",
   "212123", "212321", "232121", "111323", "131123", "131321", "112313", "132113", "132311", "211313",
   "231113", "231311", "112133", "112331", "132131", "113123", "113321", "133121", "313121", "211331",
   "231131", "213113", "213311", "213131", "311123", "311321", "331121", "312113", "312311", "332111",
   "314111", "221411", "431111", "111224", "111422", "121124", "121421", "141122", "141221", "112214",
   "112412", "122114", "122411", "142112", "142211", "241211", "221114", "413111", "241112", "134111",
   "111242", "121142", "121241", "114212", "124112", "124211", "411212", "421112", "421211", "212141",
   "214121", "412121", "111143", "111341", "131141", "114113", "114311", "411113", "411311", "113141",
   "114131", "311141", "411131", "211412", "211214", "211232", "2331112",
];

/** 比较两个码字序列。 */
const compareCodewords = (left: number[], right: number[]): number => {
   const length = Math.min(left.length, right.length);
   for (let index = 0; index < length; index++) {
      if (left[index] != right[index]) return left[index] - right[index];
   }
   return left.length - right.length;
};

/** 判断候选方案是否更优。 */
const isBetter = (candidate: Candidate, current: Candidate | null): boolean => {
   if (current == null) return true;
   if (candidate.codewords.length != current.codewords.length) return candidate.codewords.length < current.codewords.length;
   if (candidate.switchCount != current.switchCount) return candidate.switchCount < current.switchCount;
   if (candidate.shiftCount != current.shiftCount) return candidate.shiftCount < current.shiftCount;
   return compareCodewords(candidate.codewords, current.codewords) < 0;
};

/** 在候选方案前追加码字。 */
const prepend = (prefix: number[], tail: Candidate, switchCount: number = 0, shiftCount: number = 0): Candidate => {
   return {
      codewords: prefix.concat(tail.codewords),
      switchCount: tail.switchCount + switchCount,
      shiftCount: tail.shiftCount + shiftCount,
   };
};

/** 获取集合切换码字。 */
const getSwitchCode = (set: CodeSet): number => {
   if (set == "A") return CODE_A;
   if (set == "B") return CODE_B;
   return CODE_C;
};

/** 获取起始码字。 */
const getStartCode = (set: CodeSet): number => {
   if (set == "A") return 103;
   if (set == "B") return 104;
   return 105;
};

/** 获取字符在指定集合中的码字。 */
const getCharacterCode = (code: number, set: CodeSet): number => {
   if (set == "A") {
      if (code >= 0 && code <= 31) return code + 64;
      if (code >= 32 && code <= 95) return code - 32;
   }
   if (set == "B" && code >= 32 && code <= 127) return code - 32;
   return -1;
};

/** 判断当前位置是否能用 Code Set C 编码。 */
const getPairCode = (tokens: BarcodeToken[], index: number): number => {
   if (index + 1 >= tokens.length) return -1;
   const first = tokens[index];
   const second = tokens[index + 1];
   if (first.kind != "char" || second.kind != "char") return -1;
   if (first.code < 48 || first.code > 57 || second.code < 48 || second.code > 57) return -1;
   return (first.code - 48) * 10 + second.code - 48;
};

/** 将输入内容解析为 CODE128 Token。 */
const parseTokens = (value: string, gs1: boolean): BarcodeToken[] => {
   if (value == "") throw new Error("value must be set");
   if (value.startsWith(FNC1_TOKEN) || value.endsWith(FNC1_TOKEN) || value.indexOf(FNC1_TOKEN + FNC1_TOKEN) >= 0) {
      throw new Error("{FNC1} must separate two data segments");
   }
   if (value.indexOf("{FNC2}") >= 0 || value.indexOf("{FNC3}") >= 0 || value.indexOf("{FNC4}") >= 0) {
      throw new Error("FNC2, FNC3 and FNC4 are not supported");
   }
   const tokens: BarcodeToken[] = [];
   if (gs1) tokens.push({ kind: "fnc1", code: CODE_FNC1, text: "" });
   let index = 0;
   while (index < value.length) {
      if (value.substring(index, index + FNC1_TOKEN.length) == FNC1_TOKEN) {
         tokens.push({ kind: "fnc1", code: CODE_FNC1, text: "[FNC1]" });
         index += FNC1_TOKEN.length;
         continue;
      }
      const code = value.charCodeAt(index);
      if (code < 0 || code > 127) throw new Error("value only supports ASCII 0-127");
      let text = value.substring(index, index + 1);
      if (code < 32 || code == 127) text = "\\x" + code.toString(16).toUpperCase().padStart(2, "0");
      tokens.push({ kind: "char", code, text });
      index++;
   }
   return tokens;
};

/** 获取动态规划缓存键。 */
const getMemoKey = (index: number, set: CodeSet): string => {
   return index.toString() + set;
};

/** 计算当前位置到结尾的最短确定性码字序列。 */
const solve = (tokens: BarcodeToken[], index: number, set: CodeSet, memo: Map<string, Candidate | null>): Candidate | null => {
   if (index >= tokens.length) return { codewords: [], switchCount: 0, shiftCount: 0 };
   const key = getMemoKey(index, set);
   if (memo.has(key)) return memo.get(key) ?? null;
   const token = tokens[index];
   let best: Candidate | null = null;
   if (token.kind == "fnc1") {
      const tail = solve(tokens, index + 1, set, memo);
      if (tail != null) best = prepend([CODE_FNC1], tail);
      memo.set(key, best);
      return best;
   }
   if (set == "C") {
      const pairCode = getPairCode(tokens, index);
      if (pairCode >= 0) {
         const tail = solve(tokens, index + 2, set, memo);
         if (tail != null) best = prepend([pairCode], tail);
      }
   } else {
      const characterCode = getCharacterCode(token.code, set);
      if (characterCode >= 0) {
         const tail = solve(tokens, index + 1, set, memo);
         if (tail != null) best = prepend([characterCode], tail);
      }
      const shiftSet: CodeSet = set == "A" ? "B" : "A";
      const shiftCode = getCharacterCode(token.code, shiftSet);
      if (shiftCode >= 0 && characterCode < 0) {
         const tail = solve(tokens, index + 1, set, memo);
         if (tail != null) {
            const candidate = prepend([CODE_SHIFT, shiftCode], tail, 0, 1);
            if (isBetter(candidate, best)) best = candidate;
         }
      }
   }
   const sets: CodeSet[] = ["C", "B", "A"];
   for (const targetSet of sets) {
      if (targetSet == set) continue;
      let consumed = 1;
      let dataCode = getCharacterCode(token.code, targetSet);
      if (targetSet == "C") {
         dataCode = getPairCode(tokens, index);
         consumed = 2;
      }
      if (dataCode < 0) continue;
      const tail = solve(tokens, index + consumed, targetSet, memo);
      if (tail == null) continue;
      const candidate = prepend([getSwitchCode(targetSet), dataCode], tail, 1);
      if (isBetter(candidate, best)) best = candidate;
   }
   memo.set(key, best);
   return best;
};

/** 将码字宽度模式展开为条空模块。 */
const createModules = (codewords: number[]): boolean[] => {
   const modules: boolean[] = [];
   for (const codeword of codewords) {
      const pattern = CODE_PATTERNS[codeword];
      if (pattern == null) throw new Error("invalid CODE128 codeword");
      let isBar = true;
      for (let index = 0; index < pattern.length; index++) {
         const width = parseInt(pattern.substring(index, index + 1));
         for (let offset = 0; offset < width; offset++) modules.push(isBar);
         isBar = !isBar;
      }
   }
   return modules;
};

/** 创建用于人眼阅读的文本。 */
const createDisplayText = (tokens: BarcodeToken[]): string => {
   let value = "";
   for (const token of tokens) value += token.text;
   return value;
};

/** 编码 CODE128 条形码。 */
export const encodeBarcode = (value: string, gs1: boolean = false): BarcodeResult => {
   const tokens = parseTokens(value, gs1);
   const sets: CodeSet[] = ["C", "B", "A"];
   let best: Candidate | null = null;
   let bestStartPriority = 999;
   for (let priority = 0; priority < sets.length; priority++) {
      const set = sets[priority];
      const tail = solve(tokens, 0, set, new Map<string, Candidate | null>());
      if (tail == null) continue;
      const candidate = prepend([getStartCode(set)], tail);
      const isSameScore = best != null
         && candidate.codewords.length == best.codewords.length
         && candidate.switchCount == best.switchCount
         && candidate.shiftCount == best.shiftCount;
      if (isBetter(candidate, best) && !isSameScore || isSameScore && priority < bestStartPriority) {
         best = candidate;
         bestStartPriority = priority;
      }
   }
   if (best == null) throw new Error("value cannot be encoded as CODE128");
   let checksumTotal = best.codewords[0];
   for (let index = 1; index < best.codewords.length; index++) checksumTotal += best.codewords[index] * index;
   const checksum = checksumTotal % 103;
   const codewords = best.codewords.concat([checksum, CODE_STOP]);
   return {
      codewords,
      modules: createModules(codewords),
      checksum,
      displayText: createDisplayText(tokens),
   };
};

/** 校验内置 CODE128 固定向量。 */
export const verifyBarcodeVectors = (): string[] => {
   const failures: string[] = [];
   const values: string[] = ["123456", "ABcd", "\x01\x02A", "ab\x01cd", "1234AB", "1234{FNC1}56"];
   const gs1Values: boolean[] = [false, false, false, false, false, true];
   const expected: number[][] = [
      [105, 12, 34, 56, 44, 106],
      [104, 33, 34, 67, 68, 60, 106],
      [103, 65, 66, 33, 90, 106],
      [104, 65, 66, 98, 65, 67, 68, 53, 106],
      [105, 12, 34, 100, 33, 34, 66, 106],
      [105, 102, 12, 34, 102, 56, 94, 106],
   ];
   for (let index = 0; index < values.length; index++) {
      const actual = encodeBarcode(values[index], gs1Values[index]).codewords;
      if (compareCodewords(actual, expected[index]) != 0) failures.push(values[index]);
   }
   return failures;
};
